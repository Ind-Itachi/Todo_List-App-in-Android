<?xml version="1.0" encoding="utf-8"?>
<!-- Edge of the glass panel: bright outer rim, faint dark inner line, light bottom lip. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_radius" />
            <stroke android:width="0.8dp" android:color="#80FFFFFF" />
        </shape>
    </item>
    <item android:left="0.8dp" android:top="0.8dp" android:right="0.8dp" android:bottom="0.8dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_radius_inner" />
            <stroke android:width="0.6dp" android:color="#14000000" />
        </shape>
    </item>
</layer-list>
