<?xml version="1.0" encoding="utf-8"?>
<!-- Edge of the glass panel: bright outer rim, faint dark inner line, light bottom lip. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_radius" />
            <stroke android:width="1.3dp" android:color="#73FFFFFF" />
        </shape>
    </item>
    <item android:left="1.3dp" android:top="1.3dp" android:right="1.3dp" android:bottom="1.3dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_radius_inner" />
            <stroke android:width="1dp" android:color="#1A000000" />
        </shape>
    </item>
</layer-list>
