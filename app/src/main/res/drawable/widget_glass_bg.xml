<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted dark glass card with a light rim (widgets can't blur, so this is a tinted gradient). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#D9302760"
        android:centerColor="#D91E1A44"
        android:endColor="#E6140F2C" />
    <corners android:radius="26dp" />
    <stroke android:width="1dp" android:color="#59FFFFFF" />
</shape>
